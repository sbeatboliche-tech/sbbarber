rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Funciones de ayuda. Los emails son los mismos de ADMINS / BARBER_EMAIL_MAP en las apps.
    // Con "crear usuarios" deshabilitado en Firebase Auth, solo estas cuentas pueden existir.
    // Una cuenta de otra barbería (con claim 'barberia') nunca pasa como gente de SB, aunque tenga uno de estos mails.
    function sinBarberia() {
      return request.auth.token.get('barberia', null) == null;
    }
    function esDueno() {
      return request.auth != null && sinBarberia() && request.auth.token.email in ['abalo7272@gmail.com', 'carusomanu21@gmail.com'];
    }
    function esStaff() {
      return esDueno() || (request.auth != null && sinBarberia() && request.auth.token.email in [
        'ap1773508@gmail.com', 'stefanoacostasla@gmail.com',
        'rodriguezsantiagoet5@gmail.com', 'santiagofl551@gmail.com'
      ]);
    }
    // Otras barberías (multi-barbería etapa 3): la barbería y el rol vienen en el login como custom claims
    // (los pone solo el servidor, tienda/lib/usuarios.js). Sin get(): no gasta lecturas. Las cuentas de SB no
    // tienen claim, así que nunca matchean acá; y estas cuentas no son esStaff(), así que no ven nada de SB.
    function miBarberia(id) {
      return request.auth != null && request.auth.token.get('barberia', null) == id;
    }
    function esAdminDe(id) {
      return miBarberia(id) && request.auth.token.get('rol', null) == 'admin';
    }
    function deOtraBarberia() {
      return request.auth != null && request.auth.token.get('barberia', null) is string;
    }

    // Tienda y menú: lectura pública, escritura solo dueños (el admin de tienda y de menú)
    match /tienda_productos/{d}        { allow read: if true; allow write: if esDueno(); }
    match /tienda_productos_custom/{d} { allow read: if true; allow write: if esDueno(); }
    match /tienda_kits_custom/{d}      { allow read: if true; allow write: if esDueno(); }
    match /tienda_cursos/{d}           { allow read: if true; allow write: if esDueno(); }
    match /tienda_config/{d}           { allow read: if true; allow write: if esDueno(); }
    match /menu_bebidas/{d}            { allow read: if true; allow write: if esDueno(); }

    // Pedidos: el comprador (sin login) necesita poder crear/actualizar su propio pedido
    // al pagar, pero no puede aprobarlo/marcarlo enviado o retirado — eso es solo admin
    // (ni al crearlo ni después).
    match /tienda_pedidos/{d} {
      allow read: if esDueno();
      allow create: if esDueno() || (
        (!('aprobado' in request.resource.data) || request.resource.data.aprobado == false) &&
        (!('enviado' in request.resource.data) || request.resource.data.enviado == false) &&
        (!('retirado' in request.resource.data) || request.resource.data.retirado == false)
      );
      allow update: if esDueno() || (
        (!('aprobado' in request.resource.data) || request.resource.data.aprobado == resource.data.aprobado) &&
        (!('enviado' in request.resource.data) || request.resource.data.enviado == resource.data.enviado) &&
        (!('retirado' in request.resource.data) || request.resource.data.retirado == resource.data.retirado)
      );
      allow delete: if esDueno();
    }

    // Visitas: analítica de tráfico, sin datos sensibles — escritura pública, lectura solo dueños.
    match /tienda_visitas/{d} {
      allow read: if esDueno();
      allow write: if true;
    }

    // Config de cada barbería (barberos, admins, comisiones, módulos; assets/config-barberia.js):
    // la leen todos los del equipo, la cambian solo los dueños.
    match /barberias/{id} {
      allow read: if esStaff() || miBarberia(id);
      allow write: if esDueno();   // barberos y admins los da de alta el servidor (tienda/lib/usuarios.js)
    }
    // Datos de las otras barberías (multi-barbería etapa 2: barberias/{id}/cortes, retiros, ...; SB Barber
    // sigue en las colecciones de la raíz). Los usa su equipo (claim barberia == id) y nosotros, para soporte.
    // Borrar: solo sus admins (igual que en SB, donde borran solo los dueños).
    match /barberias/{id}/{col}/{d=**} {
      allow read: if esDueno() || miBarberia(id);
      // Precios y servicios (config_precios) los cambian solo sus admins, no los barberos
      allow create, update: if esDueno() || (miBarberia(id) && (col != 'config_precios' || esAdminDe(id)));
      allow delete: if esDueno() || esAdminDe(id);
    }

    // Tokens de la app del celu (assets/push.js): cada uno guarda el suyo y solo con su propio email,
    // así nadie se anota para recibir los avisos de otro (el servidor elige destinatarios por email).
    match /push_tokens/{t} {
      allow read: if esDueno();
      allow create, update: if (esStaff() || deOtraBarberia()) && request.resource.data.email == request.auth.token.email;
      allow delete: if esDueno();
    }

    // Estimado de lecturas (assets/uso-lecturas.js): la cuota es del proyecto entero, así que también suman
    // las otras barberías. Solo escriben (sumar); leerlo es de los dueños (comodín de abajo / api/uso).
    match /uso_lecturas/{d} {
      allow create, update: if deOtraBarberia();
    }

    // Resto (recepción / anotar, uso interno): solo dueños y barberos. Eliminar documentos
    // queda reservado a los dueños, así un barbero logueado en "anotar" no puede borrar sus
    // propios retiros/ventas/etc. por consola, no solo desde la UI.
    // Las colecciones de MercadoLibre (ml_config: tokens cifrados de la cuenta; ml_ordenes: qué ventas de
    // ML ya se descontaron) las escribe solo el servidor (tienda/api, con cuenta de servicio). Si un cliente
    // pudiera tocarlas, podría saltear descuentos o "devolver" stock inventado.
    // 'barberias' queda afuera: si no, este comodín (que también matchea barberias/x/retiros/...) le daría a
    // los barberos de SB acceso a los datos de otra barbería (las reglas se suman: alcanza con que una permita).
    match /{coleccion}/{document=**} {
      allow read: if (esStaff() && !(coleccion in ['ml_config', 'ml_ordenes', 'barberias'])) || (esDueno() && coleccion == 'ml_config');
      allow create, update: if esStaff() && !(coleccion in ['ml_config', 'ml_ordenes', 'barberias']);
      allow delete: if esDueno() && !(coleccion in ['ml_config', 'ml_ordenes', 'barberias']);
    }
  }
}
